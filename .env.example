NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: shows the telephone help line on the login screen once a real number exists.
NEXT_PUBLIC_SUPPORT_PHONE=

# Showcase only: false = email-only sign-in, true = require an email OTP code.
SHOWCASE_REQUIRE_EMAIL_OTP=false
# Required server-side when SHOWCASE_REQUIRE_EMAIL_OTP is false.
SUPABASE_SERVICE_ROLE_KEY=
