NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: shows the telephone help line on the login screen once a real number exists.
NEXT_PUBLIC_SUPPORT_PHONE=

# Showcase only. Exactly "false" lets showcase accounts sign in without the e-mail
# code; anything else (or unset) keeps the code for everyone.
SHOWCASE_REQUIRE_EMAIL_OTP=true
# Server-side only, and only while SHOWCASE_REQUIRE_EMAIL_OTP=false. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
