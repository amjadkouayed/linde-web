NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: shows the telephone help line on the login screen once a real number exists.
NEXT_PUBLIC_SUPPORT_PHONE=

# The showcase sign-in needs no variable and no secret key. It is switched in the
# database (0015), not in the environment:
#
#   select open_until, open_until > now() as offen from app.showcase;
#   update app.showcase set open_until = now() + interval '1 day';  -- open it
#   update app.showcase set open_until = now();                     -- close it early
